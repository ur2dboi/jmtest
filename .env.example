# ============================================================
# MJPremium Ultimate MLM System — environment variables
# Copy to `.env.local` for development and set the same keys in
# your Vercel project (Settings → Environment Variables).
# ============================================================

# REQUIRED — Postgres connection string.
#   Local    : postgres://postgres:postgres@127.0.0.1:5432/mjpremium
#   Supabase : postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Neon     : postgres://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/mjpremium"

# Force TLS even when the URL does not say sslmode=require (Supabase/Neon).
PGSSL="false"

# REQUIRED in production — secret used to sign the session JWT cookie.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Initial admin gateway account created by `npm run db:seed`.
# The plugin used the hard-coded MJPREMIUM / adminMJ2026 gateway;
# here it becomes a real (changeable) administrator user.
ADMIN_USERNAME="MJPREMIUM"
ADMIN_PASSWORD="adminMJ2026"

# Seed a demo network (members, pins, orders, earnings) — set to "0" for a clean install.
SEED_DEMO_NETWORK="1"

# Optional tuning
PG_POOL_MAX="5"
PG_STATEMENT_TIMEOUT="60000"

# Public site metadata
NEXT_PUBLIC_SITE_NAME="MJPremium"
NEXT_PUBLIC_SITE_URL="https://mjpremiumcorp.com"
